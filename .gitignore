# ==============================================================================
# AKIRA Wrist Component - Git Ignore
# ==============================================================================

# ------------------------------------------------------------------------------
# Python
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Distribution / Packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Testing & Coverage
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# Type Checking & Linters
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/

# Jupyter Notebooks
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# ------------------------------------------------------------------------------
# Node.js & Frontends (React / Vite)
# ------------------------------------------------------------------------------
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/

# Frontend build outputs & caches
dist/
dist-ssr/
out/
.vite/
.eslintcache
.turbo/

# ------------------------------------------------------------------------------
# Large Datasets & Archives (>100MB exceeds GitHub push limits)
# ------------------------------------------------------------------------------
# Raw dataset archives
01_DATASETS/RAW/*.zip
01_DATASETS/RAW/*.tar.gz
01_DATASETS/RAW/*.rar
01_DATASETS/RAW/*.7z

# Extracted multi-gigabyte dataset folders
01_DATASETS/EXTRACTED/

# Oversized generated data files (>100MB)
02_STANDARDIZED_DATA/WatchHand_standard.csv
06_FEATURES/segmented_movements.csv

# Retain directory structure
!01_DATASETS/RAW/.gitkeep
!01_DATASETS/EXTRACTED/.gitkeep

# ------------------------------------------------------------------------------
# Environment Variables & Secrets
# ------------------------------------------------------------------------------
.env
.env.local
.env.*.local
*.env
*.pem
*.key

# ------------------------------------------------------------------------------
# Operating System & IDE Files
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory
.fuse_hidden*

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# JetBrains (PyCharm, WebStorm, etc.)
.idea/
*.iws
*.iml

# ------------------------------------------------------------------------------
# Logs & Temporary Files
# ------------------------------------------------------------------------------
*.log
logs/
tmp/
temp/
