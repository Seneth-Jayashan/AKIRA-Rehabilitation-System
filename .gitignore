# ---- Raw external multi-GB archives (kept locally on disk) -----------
/datasets/
/research/
/archive/

# ---- AKIRA: Track all preprocessed training & test datasets ----------
# Only ignore runtime-generated temporary files if any; keep all .npz/.csv
# training and test splits tracked in git so training is 100% reproducible!
app/api/datasets/recorded_trials/*.tmp

# ---- Security, Privacy & Live Recorded Patient Trials ----------------
.akira_secret_salt
app/api/.akira_secret_salt
app/api/datasets/recorded_trials/*.csv
app/api/datasets/recorded_trials/*.tmp

