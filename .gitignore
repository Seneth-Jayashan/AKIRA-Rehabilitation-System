# ---- AKIRA: generated / large data files -----------------------------
# Trained models in api/models/ ARE committed so the app runs after cloning.
app/api/datasets/*
# ...except the small test split + catalog the dashboard needs at runtime
!app/api/datasets/test_20percent_dataset.npz
!app/api/datasets/test_20percent_catalog.csv

