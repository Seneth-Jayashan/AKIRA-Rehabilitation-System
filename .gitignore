# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Datasets and large data artifacts (preserve raw data locally; do not commit)
datasets/
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep
*.npy
*.npz
*.h5
*.hdf5
*.mat
*.c3d
*.mvnx
*.trc
*.mot
*.sto
*.raw

# Model checkpoints and weights
models/checkpoints/*
!models/checkpoints/.gitkeep
*.pt
*.pth
*.onnx
*.tflite
*.ckpt
*.bin

# Experiment logs, metrics, and generated outputs
experiments/logs/*
!experiments/logs/.gitkeep
experiments/metrics/*
!experiments/metrics/.gitkeep
experiments/reports/*
!experiments/reports/.gitkeep
outputs/*
!outputs/.gitkeep

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Testing and coverage caches
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# IDE and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Secrets and environment variables
.env
*.env
secrets.*
credentials.*

# Local SQLite databases
*.db
*.sqlite3
data/sessions/*.db
